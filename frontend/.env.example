# Backend Public API URL (สำหรับ Client-side เรียกใช้งานผ่าน Domain / Cloudflare Tunnel)
NEXT_PUBLIC_API_URL=https://upmatch.tcmg.me

# Internal Backend URL (สำหรับ Next.js Rewrites ส่งต่อไปหา Go Fiber ภายในเครื่อง ป้องกัน Loop)
INTERNAL_BACKEND_URL=http://127.0.0.1:8081

# Canonical Website URL สำหรับ SEO และ OpenGraph Metadata
NEXT_PUBLIC_SITE_URL=https://upmatch.tcmg.me

# GIPHY API Key สำหรับห้องแชท
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here

# Session Secret Salt สำหรับสร้าง Signature
NEXT_PUBLIC_SESSION_SECRET=your_session_secret_salt_here

# Cookie Configuration (ต้องตรงกับ backend/.env)
NEXT_PUBLIC_SESSION_COOKIE_NAME=up_match_token
NEXT_PUBLIC_EMAIL_COOKIE_NAME=upmatch_email

# Next.js Allowed Dev Origins (คั่นด้วย comma สำหรับโหมด dev ป้องกัน origin blocked)
ALLOWED_DEV_ORIGINS=localhost,localhost:3003,127.0.0.1,127.0.0.1:3003,192.168.1.109,192.168.1.109:3003,upmatch.tcmg.me
