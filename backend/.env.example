# backend/.env.example
PORT=8081
FRONTEND_URL=https://upmatch.tcmg.me,http://localhost:3003,http://127.0.0.1:3003

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Gmail API OAuth File Paths
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=upmatch
DB_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Web Push Notification (VAPID)
VAPID_PUBLIC_KEY=BKv9oOXXiRNmJEuoYDZ0GpduxCgAabgeoXxqEoZtwMX14odoTySGkchhwGitGTsC-0BZ_EmDn_6bC1foUSZiVr4
VAPID_PRIVATE_KEY=X52gLYl8ASUA2mVjwynucWT-juTsB3qn6yowkpr47Gc
VAPID_SUBJECT=mailto:your-email@gmail.com
WEBPUSH_TTL=86400

# Auth & Test Account Security
ENABLE_TEST_ACCOUNTS=true
TEST_ACCOUNT_PREFIX=123
TEST_ACCOUNT_OTP=123456

# Session & Token Settings
SESSION_TOKEN_PREFIX=up_sess_
SESSION_COOKIE_NAME=up_match_token
SESSION_EMAIL_COOKIE_NAME=upmatch_email
SESSION_DURATION_DAYS=7
OTP_EXPIRY_MINUTES=5

# Profile & Feed Configuration
DEFAULT_AVATAR_URL=https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=80
MIN_PROFILE_PHOTOS=2
MAX_PROFILE_PHOTOS=9
